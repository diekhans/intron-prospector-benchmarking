#!/usr/bin/env python3
"""Run intron-prospector on one benchmark dataset.

All intron-prospector filtering is disabled, so the calls file holds everything
the BAM contains.  The STAR SJ.out.tab filters are emulated after the fact by
sj-compare, which avoids a second pass over a multi-gigabyte BAM.

--include cannot be deferred that way, since which alignments are read is
decided during the pass, so each category set makes its own calls file rather
than a filter.
"""
import argparse
import os.path as osp
import sys
import pipettor
from pycbio.sys import cli, fileOps
import benchconf

# default build of the intron-prospector source tree, checked out beside this
# one; the Makefile passes --prospector, so this is for running by hand
PROSPECTOR = osp.join(osp.dirname(benchconf.BENCH_DIR), "intron-prospector", "bin",
                      "intron-prospector")


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prospector", default=PROSPECTOR,
                        help="intron-prospector binary to benchmark")
    parser.add_argument("--include", default=None,
                        help="intron-prospector --include categories, comma separated, "
                        "naming alignments it excludes by default: qcfail for the ones "
                        "the sequencer's chastity filter flagged, which SJ.out.tab "
                        "counts, secondary for the other loci of a multi-mapping read, "
                        "which junctions_from_sam counts")
    parser.add_argument("dataset", help="dataset name in conf/datasets.tsv")
    parser.add_argument("out_calls_tsv", help="intron calls TSV to create")
    opts, args = cli.parseOptsArgsWithLogging(parser)
    benchconf.check_dataset_name(parser, args.dataset)
    return opts, args


def input_paths(dataset):
    paths = [dataset.bam_path, dataset.sj_out_tab_path]
    if dataset.has_genome:
        paths += [dataset.genome_path] + dataset.genome_index_paths
    return paths


def genome_opts(dataset):
    if not dataset.has_genome:
        return []
    # targets absent from the genome are skipped rather than killing a long run
    return [f"--genome-fasta={dataset.genome_path}", "--skip-missing-targets"]


def include_opts(opts):
    return [f"--include={opts.include}"] if opts.include is not None else []


def prospector_cmd(opts, dataset, out_tsv):
    return [opts.prospector,
            "--min-confidence-score=0.0",
            "--sj-filter=all",
            "--min-anchor-length=1",
            *include_opts(opts),
            f"--min-intron-length={dataset.min_intron}",
            f"--max-intron-length={dataset.max_intron}",
            *genome_opts(dataset),
            f"--intron-calls={out_tsv}",
            dataset.bam_path]


def run_prospector(opts, args):
    dataset = benchconf.load_datasets()[args.dataset]
    benchconf.check_inputs(dataset, input_paths(dataset))
    fileOps.ensureFileDir(args.out_calls_tsv)
    with fileOps.AtomicFileCreate(args.out_calls_tsv) as tmp_tsv:
        cmd = prospector_cmd(opts, dataset, tmp_tsv)
        print("running:", " ".join(cmd), file=sys.stderr, flush=True)
        pipettor.run(cmd, stderr=2)


def main():
    opts, args = parse_args()
    with cli.ErrorHandler(noStackExcepts=(OSError, cli.PycbioException)):
        run_prospector(opts, args)


main()
